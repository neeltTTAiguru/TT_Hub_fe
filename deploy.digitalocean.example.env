DO_SPACES_ACCESS_KEY_ID=your_spaces_key
DO_SPACES_SECRET_ACCESS_KEY=your_spaces_secret
DO_SPACES_BUCKET=your-space-name
DO_SPACES_REGION=nyc3
DO_SPACES_PREFIX=
DO_SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com

# Short caching keeps index.html deploys easy to roll forward while the CDN is enabled.
DO_SPACES_CACHE_CONTROL=public, max-age=60, must-revalidate
